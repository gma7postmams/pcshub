{
  "name": "promotional-content-hub",
  "version": "2.0.0",
  "description": "Promotional Content Hub — multi-user ingest / approval / workload tracker",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/migrate.js",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "validator": "^13.12.0"
  }
}
