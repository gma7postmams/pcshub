# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Generate secrets on the server:   openssl rand -hex 48   (SESSION_SECRET)     openssl rand -hex 32   (the two keys)

# ---------- Required ----------
DATABASE_URL=postgresql://promohub:PASSWORD@localhost/promohub

# Signs session cookies. 32+ random characters. The app refuses to start without it (or with a placeholder).
SESSION_SECRET=

# First Admin account, created on the first start only. Must be 8+ characters with letters and numbers; a new
# password is demanded at first sign-in. Remove ADMIN_PASSWORD from this file once that Admin has signed in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=System Administrator
ADMIN_EMAIL=admin@example.com

PORT=3001

# ---------- Required on the live server (uncomment and fill all four) ----------
# NODE_ENV=production                    # secure cookies, HSTS, listens on 127.0.0.1 only, strict startup checks
# Encrypts 2FA secrets in the database (64 hex characters). Keep a copy in your password manager: without it,
# everyone's 2FA has to be reset.
# TOTP_ENC_KEY=
# TOTP_ENC_KEY_OLD=                      # only while rotating TOTP_ENC_KEY (see README)
# SESSION_SECRET_OLD=                    # one start only: the previous SESSION_SECRET, if you change it and never had a TOTP_ENC_KEY
# Behind nginx / Traefik / Caddy: lets rate limits and the audit log see the real client address.
# Leave unset when the app is reached directly, otherwise clients could fake their address.
# TRUST_PROXY=1
# Signs backup manifests so a tampered archive is detected at restore. Keep it somewhere other than the backups.
# BACKUP_SIGNING_KEY=

# ---------- Security options (defaults shown) ----------
# COOKIE_SECURE=true                     # defaults to true in production; false only on an isolated plain-HTTP LAN
# APP_ORIGIN=https://hub.example.com     # address users open; when set, changes are accepted from this origin only
# HOST=127.0.0.1                         # production default: reachable through the reverse proxy only
# SESSION_HOURS=12                       # signed out after this long without activity
# SESSION_MAX_HOURS=168                  # signed out this long after sign-in, however active
# API_RATE_LIMIT=300                     # requests per minute per client address
# LOGIN_RATE_LIMIT=20                    # sign-in attempts per 15 minutes per client address
# REAUTH_GRACE_MINUTES=5                 # how long a "confirm it's you" stays valid for further admin actions (0 = always ask)
# MIGRATE_ON_START=true                  # false = run `npm run migrate` with an owner login, app uses a DML-only login
# KNOWLEDGE_MAX_MB=25                    # largest PDF accepted by the Knowledge Base
# IMPORT_MAX_UNPACKED_MB=40              # largest workbook (unpacked) accepted by the Excel imports
# IMPORT_MAX_SHEET_MB=25                 # largest single sheet inside it

# ---------- Backup & Recovery (optional) ----------
# BACKUP_DIR=/var/lib/pcshub/backups     # keep outside the repo; default ./backups
# BACKUP_DATABASE_URL=                   # login used by pg_dump; defaults to DATABASE_URL
# BACKUP_MAX_COUNT=30
# BACKUP_MAX_MB=20480
# BACKUP_TIMEOUT_MIN=30
