# Copy to .env and fill in. Never commit .env (it is in .gitignore).
#
# Generate secrets on the server:
#   openssl rand -hex 48   # SESSION_SECRET
#   openssl rand -hex 32   # TOTP_ENC_KEY
#   openssl rand -hex 32   # BACKUP_SIGNING_KEY

# ---------- Required ----------
DATABASE_URL=postgresql://promohub:PASSWORD@localhost/promohub

# Signs session cookies. 32+ random characters. The app refuses to start without it (or with a placeholder).
SESSION_SECRET=

# First Admin account, created on the first start only. Must be 8+ characters with letters and numbers; a new
# password is demanded at first sign-in. Remove ADMIN_PASSWORD from this file once that Admin has signed in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=System Administrator
ADMIN_EMAIL=admin@example.com

PORT=3001

# ---------- Required on the live server (uncomment and fill as needed) ----------
# NODE_ENV=production                    # secure cookies, HSTS, listens on 127.0.0.1 only, strict startup checks

# Encrypts 2FA secrets stored in the database.
# Generate with: openssl rand -hex 32
# Keep a copy in your password manager. Without this key, existing 2FA enrollments may need to be reset.
# TOTP_ENC_KEY=

# Previous TOTP encryption key used during key rotation. Remove after a successful restart.
# TOTP_ENC_KEY_OLD=

# Previous session secret used during session-secret rotation.
# SESSION_SECRET_OLD=

# Behind nginx / Traefik / Caddy: lets rate limits and the audit log see the real client address.
# Leave unset when the app is reached directly.
# TRUST_PROXY=1

# Signs backup manifests so tampered backups can be detected during analysis and restore.
# Generate with: openssl rand -hex 32
# Keep a copy somewhere other than the backup storage.
# BACKUP_SIGNING_KEY=

# ---------- Security options (defaults shown) ----------
# COOKIE_SECURE=true
# APP_ORIGIN=https://hub.example.com
# HOST=127.0.0.1
# SESSION_HOURS=12
# SESSION_MAX_HOURS=168
# API_RATE_LIMIT=300
# LOGIN_RATE_LIMIT=20
# REAUTH_GRACE_MINUTES=5
# MIGRATE_ON_START=true
# KNOWLEDGE_MAX_MB=25
# IMPORT_MAX_UNPACKED_MB=40
# IMPORT_MAX_SHEET_MB=25

# ---------- Backup & Recovery (optional) ----------
# BACKUP_DIR=/var/lib/pcshub/backups
# BACKUP_DATABASE_URL=
# BACKUP_MAX_COUNT=30
# BACKUP_MAX_MB=20480
# BACKUP_TIMEOUT_MIN=30
