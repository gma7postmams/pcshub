# Database
DATABASE_URL=postgresql://localhost/promohub

# Session Security
SESSION_SECRET=change-me-to-a-random-32-character-secret

# Administrator Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_FULLNAME=System Administrator
ADMIN_EMAIL=admin@example.com

# Server
PORT=3001

# Backup & Recovery (all optional)
# BACKUP_DIR=/var/lib/pcshub/backups     # keep outside the repo; default ./backups
# BACKUP_SIGNING_KEY=                    # openssl rand -hex 32  (signs backup manifests; keep it separate from the backups)
# BACKUP_DATABASE_URL=                   # login used by pg_dump; defaults to DATABASE_URL
# BACKUP_MAX_COUNT=30
# BACKUP_MAX_MB=20480
# BACKUP_TIMEOUT_MIN=30
